# ---- Required ----

# Polymarket wallet address to copy trades from
TARGET_WALLET=

# Private key of the EOA that will place the copied orders.
# Use a dedicated wallet. Never commit this file with a value filled in.
PRIVATE_KEY=

# Polygon JSON-RPC endpoint (defaults to https://polygon-rpc.com if unset)
RPC_URL=


# ---- Trade sizing ----

# 'multiplier' = copy a fraction of the target's size
# 'fixed'      = always trade FIXED_POSITION_SIZE
POSITION_SIZE_MODE=multiplier

# Used when POSITION_SIZE_MODE=multiplier (0.1 = 10% of the original trade)
POSITION_MULTIPLIER=0.1

# Used when POSITION_SIZE_MODE=fixed
FIXED_POSITION_SIZE=5

# Hard clamps applied to the sized trade, in pUSD
MAX_TRADE_SIZE=5
MIN_TRADE_SIZE=1

# Max acceptable price slippage (0.02 = 2%)
SLIPPAGE_TOLERANCE=0.02

# LIMIT (GTC), FOK (fill-or-kill), or FAK (fill-and-kill)
ORDER_TYPE=FOK


# ---- Risk controls (0 disables the cap) ----

MAX_SESSION_NOTIONAL=0
MAX_PER_MARKET_NOTIONAL=0


# ---- Monitoring ----

USE_WEBSOCKET=true

# Use the authenticated user channel instead of the public market channel
USE_USER_CHANNEL=false

# REST polling interval in milliseconds
POLL_INTERVAL=2000

# Comma-separated token IDs to pre-subscribe to (market channel)
WS_ASSET_IDS=

# Comma-separated condition IDs to pre-subscribe to (user channel)
WS_MARKET_IDS=


# ---- Gas floor overrides for Polygon approval txs (gwei) ----

MIN_PRIORITY_FEE_GWEI=30
MIN_MAX_FEE_GWEI=60
