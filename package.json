{
  "name": "polymarket-copy-bot",
  "version": "1.0.0",
  "description": "Mirrors a target Polymarket wallet's BUY trades to your own account with configurable sizing and risk controls.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itslowis/polymarket-copy-bot.git"
  },
  "keywords": [
    "polymarket",
    "copy-trading",
    "prediction-markets",
    "polygon",
    "trading-bot"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "viem": "^2.46.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
